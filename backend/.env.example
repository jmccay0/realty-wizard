# Server Configuration
PORT=8080

# Authentication
AUTH_ENABLED=true
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters

# Database Configuration
# Options: sqlite, postgres
DB_TYPE=sqlite

# SQLite Configuration (used when DB_TYPE=sqlite)
DB_PATH=./data/realty-wizard.db

# PostgreSQL Configuration (used when DB_TYPE=postgres)
# Format: postgres://username:password@host:port/database?sslmode=disable
# POSTGRES_URL=postgres://realwiz:password@localhost:5432/realty_wizard?sslmode=disable
